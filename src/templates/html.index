      $error = $_GET['error'];

      if($error == "campos_vacios"){
        echo "<p>Error: Debes completar todos los campos.</p>";
      } elseif($error == "credenciales_invalidas"){
        echo "<p>Error: Usuario o contraseña incorrectos.</p>";
